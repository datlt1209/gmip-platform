# ==============================================================================
# Global Macro Intelligence Platform (GMIP) - Environment Variables
# ==============================================================================

# Application Configuration
PROJECT_NAME="Global Macro Intelligence Platform (GMIP)"
API_V1_PREFIX="/api/v1"
ENVIRONMENT="development"
DEBUG=true
TIMEZONE="Asia/Ho_Chi_Minh"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# Database Configuration (Default: SQLite local, PostgreSQL for Production)
# SQLite: sqlite:///./data/gmip.db
# PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/gmip_db
DATABASE_URL="sqlite:///./data/gmip.db"

# External Data APIs
# Register your free FRED API key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY="your_fred_api_key_here"

# Security & Admin Access
ADMIN_SECRET_KEY="gmip-secure-secret-key-change-in-production"

# Ingestion & Networking Controls
REQUEST_TIMEOUT_SECONDS=10
INGESTION_RATE_LIMIT_DELAY=1.2
MAX_RETRY_ATTEMPTS=3

# CORS Allowed Origins (Comma-separated list or JSON array)
CORS_ORIGINS="*"
