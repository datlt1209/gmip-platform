# Copy to .env (never commit .env). Used by docker-compose.yml.
FRED_API_KEY=your_fred_api_key_here
ADMIN_SECRET_KEY=change-me-to-a-long-random-string
# Origins allowed by backend CORS (comma-separated) - the URL users open the frontend at
CORS_ORIGINS=http://localhost:3000
# Build-time; must be reachable from the user's BROWSER (not the internal service name)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_USE_MOCK=false
